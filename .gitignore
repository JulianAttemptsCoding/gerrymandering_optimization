/.claude/
/.mcp.json
/.ignore
/papers/
__pycache__/
*.pyc
/paper/main.txt
/paper/main_new.txt
/paper/pg*.png
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.bbl
/paper/*.blg
