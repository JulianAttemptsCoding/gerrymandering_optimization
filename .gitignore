# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# raw downloads (about 2.4 GB; re-download with `python -m gf.data`)
/data/raw/
# local tooling / third-party material / scratch
/.claude/
/.mcp.json
/.ignore
/papers/
__pycache__/
*.pyc
/paper/main.txt
/paper/main_new.txt
/paper/pg*.png
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.bbl
/paper/*.blg

# scratch helpers and rendered pages from the revision round
/scratch/pages/
/scratch/fix_*.py
/scratch/add_*.py
/scratch/edit_*.py
/scratch/patch_*.py
/scratch/set_*.py
/scratch/readme_update.py
/scratch/render.py
/scratch/*.txt
/scratch/*_old.tex
/scratch/*_new*.tex
